# dependencies
node_modules/

# build output
dist/
build/
coverage/
*.tsbuildinfo

# env & secrets
.env
.env.local
.env.*.local
!.env.example

# generated files (protected by arch check)
packages/database/src/generated/

# logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# editor / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# temp (arch rule #8: only tmp/ allowed, always gitignored)
tmp/
*.tmp
*.bak

# prisma
packages/database/prisma/*.db

# 样板页预览构建产物（源码见 apps/*/preview，入口是仓库根 index.html）
preview/web/
preview/mobile/

# k8s secrets: 明文不入库，仅提交 SOPS 加密后的 *.enc.yaml（见 .sops.yaml）
k8s/base/*-secret.yaml
Dockerfile.verify
