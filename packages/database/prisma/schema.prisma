// Owl 基础数据模型（底座）
// 命名规范：下划线分隔，无 deprecated/backup 前后缀，表名复数语义
// 主键规范：所有表使用 Int 自增 id；删除规范：所有表软删除（deletedAt）
// 时间规范：所有表统一 createdAt / updatedAt

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  unionId        String       @unique @map("union_id")
  openId         String       @map("open_id")
  name           String
  nickname       String?
  enName         String?      @map("en_name")
  description    String?
  email          String?
  avatar72       String?      @map("avatar_72")
  avatar240      String?      @map("avatar_240")
  avatar640      String?      @map("avatar_640")
  avatarOrigin   String?      @map("avatar_origin")
  mobileVisible  Boolean?     @map("mobile_visible")
  departmentIds  Json?        @map("department_ids")
  status         String       @default("active")
  departmentId   String?      @map("department_id")
  lastLoginAt    DateTime? @db.Timestamp(0)    @map("last_login_at")
  createdAt      DateTime @db.Timestamp(0)     @default(now()) @map("created_at")
  updatedAt      DateTime @db.Timestamp(0)     @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @db.Timestamp(0)    @map("deleted_at")
  department     Department?  @relation(fields: [departmentId], references: [feishuDepartmentId], onDelete: SetNull)
  roles          UserRole[]
  sessions       AuthSession[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  files          File[]
  mcpSessions    McpSession[]
  mcpToolLogs    McpToolLog[]
  sentRecognitions     Recognition[] @relation("RecognitionSender")
  receivedRecognitions Recognition[] @relation("RecognitionReceiver")
  recognitionLikes     RecognitionLike[]
  coinAccount     CoinAccount?
  staminaAccount  StaminaAccount?
  exchangeOrders  ExchangeOrder[]
  mdDocs          MdDoc[]

  @@map("user")
}

model Department {
  id                 Int          @id @default(autoincrement())
  feishuDepartmentId String       @unique @map("feishu_department_id")
  openDepartmentId   String?      @unique @map("open_department_id")
  name               String
  i18nName           Json?        @map("i18n_name")
  parentId           String?      @map("parent_id")
  order              Int          @default(0)
  leaderUserId       String?      @map("leader_user_id")
  leaders            Json?
  memberCount        Int?         @map("member_count")
  primaryMemberCount Int?         @map("primary_member_count")
  isDeleted          Boolean?     @default(false) @map("is_deleted")
  createdAt          DateTime @db.Timestamp(0)     @default(now()) @map("created_at")
  updatedAt          DateTime @db.Timestamp(0)     @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime? @db.Timestamp(0)    @map("deleted_at")
  parent             Department?  @relation("DeptTree", fields: [parentId], references: [feishuDepartmentId])
  children           Department[] @relation("DeptTree")
  users              User[]

  @@map("department")
}

model SyncLog {
  id         Int       @id @default(autoincrement())
  type       String
  status     String    @default("running")
  startedAt  DateTime @db.Timestamp(0)  @map("started_at")
  finishedAt DateTime? @db.Timestamp(0) @map("finished_at")
  total      Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  errorMsg   String?   @map("error_msg")
  createdAt  DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt  DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @db.Timestamp(0) @map("deleted_at")

  @@map("sync_log")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime @db.Timestamp(0)         @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)         @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0)        @map("deleted_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  name        String
  resource    String
  action      String
  description String?
  createdAt   DateTime @db.Timestamp(0)         @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)         @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0)        @map("deleted_at")
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime @db.Timestamp(0)   @default(now()) @map("created_at")
  updatedAt    DateTime @db.Timestamp(0)   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @db.Timestamp(0)  @map("deleted_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  roleId    Int       @map("role_id")
  createdAt DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @db.Timestamp(0) @map("deleted_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role")
}

model AuthSession {
  id         Int       @id @default(autoincrement())
  jti        String    @unique
  userId     Int       @map("user_id")
  clientName String    @map("client_name")
  status     String    @default("active")
  createdAt  DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt  DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  expiresAt  DateTime @db.Timestamp(0)  @map("expires_at")
  lastUsedAt DateTime @db.Timestamp(0)  @default(now()) @map("last_used_at")
  deletedAt  DateTime? @db.Timestamp(0) @map("deleted_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("auth_session")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  userId     Int?      @map("user_id")
  unionId    String?
  action     String
  resource   String
  resourceId String?   @map("resource_id")
  detail     Json?
  ip         String?
  ipRegion   String?   @map("ip_region")
  requestId  String?   @map("request_id")
  result     String    @default("success")
  system     String?
  module     String?
  createdAt  DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt  DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @db.Timestamp(0) @map("deleted_at")
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_log")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  title     String
  content   String
  type      String    @default("system")
  channel   String    @default("webhook")
  status    String    @default("unread")
  sentAt    DateTime? @db.Timestamp(0) @map("sent_at")
  createdAt DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @db.Timestamp(0) @map("deleted_at")
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("notification")
}

model File {
  id          Int          @id @default(autoincrement())
  name        String
  mimeType    String       @map("mime_type")
  size        Int
  bucket      String
  objectKey   String       @map("object_key")
  url         String?
  uploadedBy  Int          @map("uploaded_by")
  createdAt   DateTime @db.Timestamp(0)     @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)     @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0)    @map("deleted_at")
  user        User         @relation(fields: [uploadedBy], references: [id])
  mdDocImages MdDocImage[]

  @@index([bucket, objectKey])
  @@map("file")
}

model SystemConfig {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  value       Json
  description String?
  updatedBy   Int?      @map("updated_by")
  createdAt   DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0) @map("deleted_at")

  @@map("system_config")
}

model FieldConfig {
  id          Int       @id @default(autoincrement())
  category    String
  module      String
  label       String
  options     Json?
  value       String?
  description String?
  createdAt   DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0) @map("deleted_at")

  @@unique([category, module])
  @@map("field_config")
}

model McpTool {
  id                Int       @id @default(autoincrement())
  name              String    @unique
  description       String
  inputSchema       Json      @map("input_schema")
  bundle            String
  targetDomain      String    @map("target_domain")
  enabled           Boolean   @default(true)
  requirePermission Boolean   @default(true) @map("require_permission")
  createdAt         DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt         DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime? @db.Timestamp(0) @map("deleted_at")

  @@map("mcp_tool")
}

model McpSession {
  id         Int       @id @default(autoincrement())
  sessionId  String    @unique @map("session_id")
  userId     Int       @map("user_id")
  clientName String    @map("client_name")
  status     String    @default("active")
  createdAt  DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt  DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  expiresAt  DateTime @db.Timestamp(0)  @map("expires_at")
  lastUsedAt DateTime @db.Timestamp(0)  @default(now()) @map("last_used_at")
  deletedAt  DateTime? @db.Timestamp(0) @map("deleted_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientName, status])
  @@map("mcp_session")
}

model McpToolLog {
  id         Int       @id @default(autoincrement())
  toolName   String    @map("tool_name")
  userId     Int       @map("user_id")
  unionId    String?
  arguments  Json?
  durationMs Int?      @map("duration_ms")
  resultCode String    @map("result_code")
  requestId  String?   @map("request_id")
  createdAt  DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt  DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @db.Timestamp(0) @map("deleted_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolName, createdAt])
  @@map("mcp_tool_log")
}

model SchedulerConfig {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  area        String
  cron        String
  queue       String
  handler     String
  tags        String[]
  module      String?
  env         String         @default("all") // dev: 仅开发环境, prod: 仅生产环境, all: 所有环境
  retryPolicy Json           @map("retry_policy")
  timeoutMs   Int            @map("timeout_ms")
  enabled     Boolean        @default(true)
  description String?
  createdAt   DateTime @db.Timestamp(0)       @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)       @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0)      @map("deleted_at")
  runs        SchedulerRun[]

  @@map("scheduler_config")
}

model SchedulerRun {
  id          Int              @id @default(autoincrement())
  taskRunId   String           @unique @map("task_run_id")
  configId    Int?             @map("config_id")
  area        String?
  taskName    String?          @map("task_name")
  env         String           @default("all")
  scheduledAt DateTime @db.Timestamp(0)         @map("scheduled_at")
  startedAt   DateTime? @db.Timestamp(0)        @map("started_at")
  finishedAt  DateTime? @db.Timestamp(0)        @map("finished_at")
  status      String           @default("PENDING")
  attempts    Int              @default(0)
  lastError   String?          @map("last_error")
  businessKey String?          @map("business_key")
  createdAt   DateTime @db.Timestamp(0)         @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)         @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0)        @map("deleted_at")
  config      SchedulerConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([configId, status, scheduledAt])
  @@map("scheduler_run")
}

// ========== 认可中心 ==========

model Badge {
  id           Int           @id @default(autoincrement())
  name         String
  icon         String?
  description  String?
  coinReward   Int           @default(0) @map("coin_reward")
  expReward    Int           @default(0) @map("exp_reward")
  enabled      Boolean       @default(true)
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime @db.Timestamp(0)      @default(now()) @map("created_at")
  updatedAt    DateTime @db.Timestamp(0)      @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @db.Timestamp(0)     @map("deleted_at")
  recognitions Recognition[]

  @@map("badge")
}

model Recognition {
  id           Int               @id @default(autoincrement())
  senderId     Int               @map("sender_id")
  receiverId   Int               @map("receiver_id")
  badgeId      Int?              @map("badge_id")
  message      String
  status       String            @default("pending") // pending / approved / rejected
  pinned       Boolean           @default(false)
  approverId   Int?              @map("approver_id")
  approvedAt   DateTime? @db.Timestamp(0)         @map("approved_at")
  rejectReason String?           @map("reject_reason")
  createdAt    DateTime @db.Timestamp(0)          @default(now()) @map("created_at")
  updatedAt    DateTime @db.Timestamp(0)          @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @db.Timestamp(0)         @map("deleted_at")
  sender       User              @relation("RecognitionSender", fields: [senderId], references: [id])
  receiver     User              @relation("RecognitionReceiver", fields: [receiverId], references: [id])
  badge        Badge?            @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  likes        RecognitionLike[]

  @@index([receiverId, status])
  @@index([createdAt])
  @@map("recognition")
}

model RecognitionLike {
  id            Int         @id @default(autoincrement())
  recognitionId Int         @map("recognition_id")
  userId        Int         @map("user_id")
  createdAt     DateTime @db.Timestamp(0)    @default(now()) @map("created_at")
  updatedAt     DateTime @db.Timestamp(0)    @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @db.Timestamp(0)   @map("deleted_at")
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recognitionId, userId])
  @@map("recognition_like")
}

model CoinAccount {
  id          Int               @id @default(autoincrement())
  userId      Int               @unique @map("user_id")
  balance     Int               @default(0)
  totalEarned Int               @default(0) @map("total_earned")
  totalSpent  Int               @default(0) @map("total_spent")
  createdAt   DateTime @db.Timestamp(0)          @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)          @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0)         @map("deleted_at")
  user        User              @relation(fields: [userId], references: [id])
  transactions CoinTransaction[]

  @@map("coin_account")
}

model CoinTransaction {
  id          Int         @id @default(autoincrement())
  accountId   Int         @map("account_id")
  type        String // earn / spend / adjust
  amount      Int
  balance     Int // 交易后余额
  source      String // recognition / exchange / admin_adjust
  referenceId String?     @map("reference_id")
  remark      String?
  operatorId  Int?        @map("operator_id")
  createdAt   DateTime @db.Timestamp(0)    @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)    @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0)   @map("deleted_at")
  account     CoinAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@map("coin_transaction")
}

model StaminaAccount {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  current     Int       @default(50)
  maxStamina  Int       @default(50) @map("max_stamina")
  month       String // YYYY-MM
  lastResetAt DateTime? @db.Timestamp(0) @map("last_reset_at")
  createdAt   DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @db.Timestamp(0) @map("deleted_at")
  user        User      @relation(fields: [userId], references: [id])

  @@map("stamina_account")
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  description    String?
  image          String?
  price          Int // 币价格
  stock          Int             @default(0)
  enabled        Boolean         @default(true)
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime @db.Timestamp(0)        @default(now()) @map("created_at")
  updatedAt      DateTime @db.Timestamp(0)        @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @db.Timestamp(0)       @map("deleted_at")
  exchangeOrders ExchangeOrder[]

  @@map("product")
}

model ExchangeOrder {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  productId    Int       @map("product_id")
  quantity     Int       @default(1)
  totalCost    Int       @map("total_cost")
  status       String    @default("pending") // pending / approved / rejected / fulfilled
  approverId   Int?      @map("approver_id")
  approvedAt   DateTime? @db.Timestamp(0) @map("approved_at")
  rejectReason String?   @map("reject_reason")
  fulfilledAt  DateTime? @db.Timestamp(0) @map("fulfilled_at")
  createdAt    DateTime @db.Timestamp(0)  @default(now()) @map("created_at")
  updatedAt    DateTime @db.Timestamp(0)  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @db.Timestamp(0) @map("deleted_at")
  user         User      @relation(fields: [userId], references: [id])
  product      Product   @relation(fields: [productId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("exchange_order")
}

// ========== 付费知识（副业域） ==========

model MdDoc {
  id        Int          @id @default(autoincrement())
  authorId  Int          @map("author_id")
  content   String
  excerpt   String?
  createdAt DateTime @db.Timestamp(0)     @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamp(0)     @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @db.Timestamp(0)    @map("deleted_at")

  author User          @relation(fields: [authorId], references: [id])
  images MdDocImage[]

  @@index([authorId])
  @@map("md_doc")
}

model MdDocImage {
  id        Int       @id @default(autoincrement())
  docId     Int       @map("doc_id")
  fileId    Int       @map("file_id")
  createdAt DateTime  @db.Timestamp(0) @default(now()) @map("created_at")
  updatedAt DateTime  @db.Timestamp(0) @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @db.Timestamp(0) @map("deleted_at")

  doc  MdDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  file File  @relation(fields: [fileId], references: [id])

  @@index([docId])
  @@map("md_doc_image")
}

// ========== 系统日志（日志中心） ==========

model SystemLog {
  id        Int       @id @default(autoincrement())
  service   String? // api-service / cron-service
  level     String // error / warn
  message   String
  stack     String?
  requestId String?   @map("request_id")
  method    String?
  url       String?
  status    Int?
  code      Int?
  userId    Int?      @map("user_id")
  createdAt DateTime  @db.Timestamp(0) @default(now()) @map("created_at")
  updatedAt DateTime  @db.Timestamp(0) @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @db.Timestamp(0) @map("deleted_at")

  @@index([level, createdAt])
  @@index([service, createdAt])
  @@map("system_log")
}
