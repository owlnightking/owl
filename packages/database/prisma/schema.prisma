// Owl 基础数据模型（底座）
// 命名规范：下划线分隔，无 deprecated/backup 前后缀，表名复数语义

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(uuid())
  unionId        String       @unique @map("union_id")
  openId         String       @map("open_id")
  name           String
  nickname       String?
  enName         String?      @map("en_name")
  description    String?
  email          String?
  avatar72       String?      @map("avatar_72")
  avatar240      String?      @map("avatar_240")
  avatar640      String?      @map("avatar_640")
  avatarOrigin   String?      @map("avatar_origin")
  mobileVisible  Boolean?     @map("mobile_visible")
  departmentIds  Json?        @map("department_ids")
  status         String       @default("active")
  departmentId   String?      @map("department_id")
  lastLoginAt    DateTime?    @map("last_login_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  department     Department?  @relation(fields: [departmentId], references: [feishuDepartmentId], onDelete: SetNull)
  roles          UserRole[]
  sessions       AuthSession[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  files          File[]
  mcpSessions    McpSession[]
  mcpToolLogs    McpToolLog[]
  sentRecognitions     Recognition[] @relation("RecognitionSender")
  receivedRecognitions Recognition[] @relation("RecognitionReceiver")
  recognitionLikes     RecognitionLike[]
  coinAccount     CoinAccount?
  staminaAccount  StaminaAccount?
  exchangeOrders  ExchangeOrder[]
  mdDocs          MdDoc[]

  @@map("user")
}

model Department {
  id                 String       @id @default(uuid())
  feishuDepartmentId String       @unique @map("feishu_department_id")
  openDepartmentId   String?      @unique @map("open_department_id")
  name               String
  i18nName           Json?        @map("i18n_name")
  parentId           String?      @map("parent_id")
  order              Int          @default(0)
  leaderUserId       String?      @map("leader_user_id")
  leaders            Json?
  memberCount        Int?         @map("member_count")
  primaryMemberCount Int?         @map("primary_member_count")
  isDeleted          Boolean?     @default(false) @map("is_deleted")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  parent             Department?  @relation("DeptTree", fields: [parentId], references: [feishuDepartmentId])
  children           Department[] @relation("DeptTree")
  users              User[]

  @@map("department")
}

model SyncLog {
  id         String    @id @default(uuid())
  type       String
  status     String    @default("running")
  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")
  total      Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  errorMsg   String?   @map("error_msg")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("sync_log")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

model AuthSession {
  id         String    @id @default(uuid())
  jti        String    @unique
  userId     String    @map("user_id")
  clientName String    @map("client_name")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("auth_session")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  unionId    String?
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  detail     Json?
  ip         String?
  requestId  String?  @map("request_id")
  result     String   @default("success")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_log")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  title     String
  content   String
  type      String    @default("system")
  channel   String    @default("webhook")
  status    String    @default("unread")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("notification")
}

model File {
  id         String   @id @default(uuid())
  name       String
  mimeType   String   @map("mime_type")
  size       Int
  bucket     String
  objectKey  String   @map("object_key")
  url        String?
  uploadedBy String   @map("uploaded_by")
  user       User     @relation(fields: [uploadedBy], references: [id])
  mdDocImages MdDocImage[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([bucket, objectKey])
  @@map("file")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("system_config")
}

model FieldConfig {
  id          String   @id @default(uuid())
  category    String
  module      String
  label       String
  options     Json?
  value       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([category, module])
  @@map("field_config")
}

model McpTool {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String
  inputSchema       Json     @map("input_schema")
  bundle            String
  targetDomain      String   @map("target_domain")
  enabled           Boolean  @default(true)
  requirePermission Boolean  @default(true) @map("require_permission")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("mcp_tool")
}

model McpSession {
  id         String    @id @default(uuid())
  sessionId  String    @unique @map("session_id")
  userId     String    @map("user_id")
  clientName String    @map("client_name")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientName, status])
  @@map("mcp_session")
}

model McpToolLog {
  id         String   @id @default(uuid())
  toolName   String   @map("tool_name")
  userId     String   @map("user_id")
  unionId    String?
  arguments  Json?
  durationMs Int?     @map("duration_ms")
  resultCode String   @map("result_code")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolName, createdAt])
  @@map("mcp_tool_log")
}

model SchedulerConfig {
  id          String   @id @default(uuid())
  name        String   @unique
  area        String
  cron        String
  queue       String
  handler     String
  tags        String[]
  module      String?
  env         String   @default("all")  // dev: 仅开发环境, prod: 仅生产环境, all: 所有环境
  retryPolicy Json     @map("retry_policy")
  timeoutMs   Int      @map("timeout_ms")
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  runs        SchedulerRun[]

  @@map("scheduler_config")
}

model SchedulerRun {
  id          String    @id @default(uuid())
  taskRunId   String    @unique @map("task_run_id")
  configId    String?   @map("config_id")
  area        String?
  taskName    String?   @map("task_name")
  env         String    @default("all")
  scheduledAt DateTime  @map("scheduled_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  businessKey String?   @map("business_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  config      SchedulerConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([configId, status, scheduledAt])
  @@map("scheduler_run")
}

// ========== 认可中心 ==========

model Badge {
  id          String   @id @default(uuid())
  name        String
  icon        String?
  description String?
  coinReward  Int      @default(0) @map("coin_reward")
  expReward   Int      @default(0) @map("exp_reward")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  recognitions Recognition[]

  @@map("badge")
}

model Recognition {
  id           String   @id @default(uuid())
  senderId     String   @map("sender_id")
  receiverId   String   @map("receiver_id")
  badgeId      String?  @map("badge_id")
  message      String
  status       String   @default("pending") // pending / approved / rejected
  pinned       Boolean  @default(false)
  approverId   String?  @map("approver_id")
  approvedAt   DateTime? @map("approved_at")
  rejectReason String?  @map("reject_reason")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  sender       User     @relation("RecognitionSender", fields: [senderId], references: [id])
  receiver     User     @relation("RecognitionReceiver", fields: [receiverId], references: [id])
  badge        Badge?   @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  likes        RecognitionLike[]

  @@index([receiverId, status])
  @@index([createdAt])
  @@map("recognition")
}

model RecognitionLike {
  id             String   @id @default(uuid())
  recognitionId  String   @map("recognition_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  recognition    Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recognitionId, userId])
  @@map("recognition_like")
}

model CoinAccount {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Int      @default(0)
  totalEarned Int    @default(0) @map("total_earned")
  totalSpent  Int    @default(0) @map("total_spent")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])
  transactions CoinTransaction[]

  @@map("coin_account")
}

model CoinTransaction {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  type        String   // earn / spend / adjust
  amount      Int
  balance     Int      // 交易后余额
  source      String   // recognition / exchange / admin_adjust
  referenceId String?  @map("reference_id")
  remark      String?
  operatorId  String?  @map("operator_id")
  createdAt   DateTime @default(now()) @map("created_at")
  account     CoinAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@map("coin_transaction")
}

model StaminaAccount {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  current      Int      @default(50)
  maxStamina   Int      @default(50) @map("max_stamina")
  month        String   // YYYY-MM
  lastResetAt  DateTime? @map("last_reset_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id])

  @@map("stamina_account")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  image       String?
  price       Int      // 币价格
  stock       Int      @default(0)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  exchangeOrders ExchangeOrder[]

  @@map("product")
}

model ExchangeOrder {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  productId   String   @map("product_id")
  quantity    Int      @default(1)
  totalCost   Int      @map("total_cost")
  status      String   @default("pending") // pending / approved / rejected / fulfilled
  approverId  String?  @map("approver_id")
  approvedAt  DateTime? @map("approved_at")
  rejectReason String? @map("reject_reason")
  fulfilledAt DateTime? @map("fulfilled_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("exchange_order")
}

// ========== 付费知识（副业域） ==========

model MdDoc {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  content   String
  excerpt   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User          @relation(fields: [authorId], references: [id])
  images MdDocImage[]

  @@index([authorId])
  @@map("md_doc")
}

model MdDocImage {
  id        String   @id @default(uuid())
  docId     String   @map("doc_id")
  fileId    String   @map("file_id")
  createdAt DateTime @default(now()) @map("created_at")

  doc  MdDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id])

  @@index([docId])
  @@map("md_doc_image")
}
