# --- 服务 ---
# api-service
API_PORT=5100
API_PREFIX=api

# cron-service
CRON_PORT=5101

# --- PostgreSQL（复用本机 docker 容器 postgresql，bitnami/postgresql:18）---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_DB=owl
DATABASE_URL=postgresql://admin:123456@localhost:5432/owl?schema=public

# --- Redis（复用本机 docker 容器 redis，密码 123456）---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456

# --- RabbitMQ（复用本机 docker 容器 rabbitmq）---
RABBITMQ_URL=amqp://admin:123456@localhost:5672

# --- MinIO（复用本机 docker 容器 minio，bitnamilegacy/minio）---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# 浏览器可访问的 MinIO 公网地址，用于拼接对外图片链接（生产改为宿主机公网 IP:端口）
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=minio123456
MINIO_BUCKET_CREATIVES=creatives
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_ATTACHMENTS=attachments
MINIO_BUCKET_EXPORTS=exports

# --- 飞书 ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书回调地址由请求 host 动态拼接（web 入口 -> :5172，mobile 入口 -> :5173），
# 此变量仅作非空校验；飞书开放平台需把两个 dev 回调地址都加入重定向白名单。
FEISHU_REDIRECT_URI=http://localhost:5172/api/auth/feishu/callback
FEISHU_BUSINESS_APP_ID=
FEISHU_BUSINESS_APP_SECRET=

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=3d

# --- Cookie（SSO 会话） ---
# COOKIE_DOMAIN=localhost
# COOKIE_SECURE=false

# --- 前端（dev 双网关：web 入口按 /portal /owl /admin /cron 分发，mobile 入口按 /mobile 分发） ---
WEB_GATEWAY_PORT=5172
MOBILE_GATEWAY_PORT=5173
PORTAL_WEB_PORT=5270
OWL_WEB_PORT=5273
ADMIN_WEB_PORT=5274
CRON_WEB_PORT=5275
MOBILE_WEB_PORT=5276
