# --- 服务 ---
# api-service
API_PORT=5100
API_PREFIX=api

# cron-service
CRON_PORT=5101

# --- PostgreSQL（复用本机 docker 容器 postgresql，bitnami/postgresql:18）---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_DB=owl
DATABASE_URL=postgresql://admin:123456@localhost:5432/owl?schema=public

# --- Redis（复用本机 docker 容器 redis，密码 123456）---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456

# --- RabbitMQ（复用本机 docker 容器 rabbitmq）---
RABBITMQ_URL=amqp://admin:123456@localhost:5672

# --- MinIO（复用本机 docker 容器 minio，bitnamilegacy/minio）---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=minio123456
MINIO_BUCKET_CREATIVES=creatives
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_ATTACHMENTS=attachments
MINIO_BUCKET_EXPORTS=exports

# --- 飞书 ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:5173/api/auth/feishu/callback
FEISHU_BUSINESS_APP_ID=
FEISHU_BUSINESS_APP_SECRET=

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=3d

# --- Cookie（SSO 会话） ---
# COOKIE_DOMAIN=localhost
# COOKIE_SECURE=false

# --- 前端（统一入口网关监听 GATEWAY_PORT，按 /portal /owl /admin /cron /m 前缀分发） ---
GATEWAY_PORT=5173
PORTAL_WEB_PORT=5270
OWL_WEB_PORT=5273
ADMIN_WEB_PORT=5274
CRON_WEB_PORT=5275
MOBILE_WEB_PORT=5276
