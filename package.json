{
  "name": "owl",
  "private": true,
  "version": "0.1.1",
  "description": "Owl - 跨境电商内网管理系统（monorepo）",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "bash scripts/dev.sh",
    "stop": "bash scripts/stop.sh",
    "verify:quick": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm arch:check",
    "verify:full": "pnpm verify:quick && pnpm smoke",
    "feature:check": "bash scripts/check-feature-rules.sh",
    "typecheck": "bash scripts/check-typecheck.sh",
    "lint": "bash scripts/check-lint.sh",
    "format:check": "prettier --check .",
    "arch:check": "bash scripts/check-architecture.sh",
    "test": "pnpm -r test",
    "smoke": "bash scripts/smoke.sh",
    "release": "bash scripts/release.sh",
    "version:all:patch": "pnpm version patch -m \"chore: bump version to %s\" --no-git-tag-version && pnpm -r exec pnpm version patch --no-git-tag-version",
    "version:all:minor": "pnpm version minor -m \"chore: bump version to %s\" --no-git-tag-version && pnpm -r exec pnpm version minor --no-git-tag-version",
    "version:all:major": "pnpm version major -m \"chore: bump version to %s\" --no-git-tag-version && pnpm -r exec pnpm version major --no-git-tag-version",
    "version:api-service:patch": "pnpm --filter @owl/api-service exec pnpm version patch --no-git-tag-version",
    "version:api-service:minor": "pnpm --filter @owl/api-service exec pnpm version minor --no-git-tag-version",
    "version:api-service:major": "pnpm --filter @owl/api-service exec pnpm version major --no-git-tag-version",
    "version:cron-service:patch": "pnpm --filter @owl/cron-service exec pnpm version patch --no-git-tag-version",
    "version:cron-service:minor": "pnpm --filter @owl/cron-service exec pnpm version minor --no-git-tag-version",
    "version:cron-service:major": "pnpm --filter @owl/cron-service exec pnpm version major --no-git-tag-version",
    "version:admin-web:patch": "pnpm --filter @owl/admin-web exec pnpm version patch --no-git-tag-version",
    "version:admin-web:minor": "pnpm --filter @owl/admin-web exec pnpm version minor --no-git-tag-version",
    "version:admin-web:major": "pnpm --filter @owl/admin-web exec pnpm version major --no-git-tag-version",
    "version:owl-web:patch": "pnpm --filter @owl/owl-web exec pnpm version patch --no-git-tag-version",
    "version:owl-web:minor": "pnpm --filter @owl/owl-web exec pnpm version minor --no-git-tag-version",
    "version:owl-web:major": "pnpm --filter @owl/owl-web exec pnpm version major --no-git-tag-version",
    "version:cron-web:patch": "pnpm --filter @owl/cron-web exec pnpm version patch --no-git-tag-version",
    "version:cron-web:minor": "pnpm --filter @owl/cron-web exec pnpm version minor --no-git-tag-version",
    "version:cron-web:major": "pnpm --filter @owl/cron-web exec pnpm version major --no-git-tag-version"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.16.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
